{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/invoices/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "env": {
    "JWT_SECRET": "vercel_super_secret_jwt_key_2026",
    "JWT_EXPIRE": "7d",
    "NODE_ENV": "production"
  }
}
